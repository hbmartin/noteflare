{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noteflare-public",
  "main": "src/worker/public-worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Replace these deployment inputs; do not put this hostname behind Access.
  // Set BETTER_AUTH_SECRET to this installation's application value for signed DO
  // calls and share grants. Set Turnstile keys if enabling public input surfaces.
  // Do not copy bootstrap, OAuth, webhook, Slack or AI credentials to this Worker.
  "routes": [{ "pattern": "public.example.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "noteflare", "database_id": "00000000-0000-0000-0000-000000000000" },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "noteflare" },
    { "binding": "PUBLICATIONS_BUCKET", "bucket_name": "noteflare-publications-private" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT", "class_name": "Document", "script_name": "noteflare" },
      { "name": "TABLE", "class_name": "TableAuthority", "script_name": "noteflare" },
      { "name": "PASSWORD_CRYPTO", "class_name": "PasswordCrypto", "script_name": "noteflare" },
    ],
  },
  "ratelimits": [
    { "name": "API_BURST_LIMIT", "namespace_id": "2101", "simple": { "limit": 100, "period": 10 } },
    { "name": "API_SOURCE_BURST_LIMIT", "namespace_id": "2103", "simple": { "limit": 300, "period": 10 } },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://app.example.com",
    "PUBLIC_BASE_URL": "https://public.example.com",
    "PUBLIC_PUBLISHING_ENABLED": "true",
    "TABLE_AUTHORITY_ENABLED": "true",
    "FORMS_ENABLED": "false",
    "TURNSTILE_ENABLED": "false",
    "IMAGES_ENABLED": "false",
    "CUSTOM_HOSTNAMES_ENABLED": "false",
  },
}
