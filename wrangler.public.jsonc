{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-realtime-notes-public",
  "main": "src/worker/public-worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
  // Replace these deployment inputs; do not put this hostname behind Access.
  // Set BETTER_AUTH_SECRET to this installation's application value for signed DO
  // calls and share grants. Set Turnstile keys if enabling public input surfaces.
  // Do not copy bootstrap, OAuth, webhook, Slack or AI credentials to this Worker.
  "routes": [{ "pattern": "public.sparkedinnovations.training", "custom_domain": true }],
  "images": { "binding": "IMAGES" },
  "analytics_engine_datasets": [{ "binding": "OBSERVABILITY", "dataset": "cloudflare_realtime_notes_production" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-realtime-notes",
      "database_id": "a1e3ebcb-6fb4-4cdb-8ccc-ef5821fb6fbc",
    },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "cloudflare-realtime-notes" },
    { "binding": "PUBLICATIONS_BUCKET", "bucket_name": "cloudflare-realtime-notes-publications" },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOCUMENT", "class_name": "Document", "script_name": "cloudflare-realtime-notes" },
      { "name": "TABLE", "class_name": "TableAuthority", "script_name": "cloudflare-realtime-notes" },
      { "name": "PASSWORD_CRYPTO", "class_name": "PasswordCrypto", "script_name": "cloudflare-realtime-notes" },
    ],
  },
  "ratelimits": [
    { "name": "API_BURST_LIMIT", "namespace_id": "2101", "simple": { "limit": 100, "period": 10 } },
    { "name": "API_SOURCE_BURST_LIMIT", "namespace_id": "2103", "simple": { "limit": 300, "period": 10 } },
  ],
  "vars": {
    "CANONICAL_REDIRECTS_ENABLED": "true",
    "COST_REPORTING_ENABLED": "false",
    "BETTER_AUTH_URL": "https://notes.sparkedinnovations.training",
    "PUBLIC_BASE_URL": "https://public.sparkedinnovations.training",
    "PUBLIC_PUBLISHING_ENABLED": "false",
    "TABLE_AUTHORITY_ENABLED": "true",
    "FORMS_ENABLED": "false",
    "TURNSTILE_ENABLED": "false",
    "IMAGES_ENABLED": "false",
    "CUSTOM_HOSTNAMES_ENABLED": "false",
  },
}
